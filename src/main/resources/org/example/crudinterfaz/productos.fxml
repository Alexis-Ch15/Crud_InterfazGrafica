<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.crudinterfaz.ProductosController">
   <padding>
      <Insets bottom="20" left="20" right="20" top="20" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Registro / Edición de Producto" />
      <GridPane hgap="10" vgap="10">
         <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33" />
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33" />
            <ColumnConstraints hgrow="ALWAYS" percentWidth="34" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints minHeight="10.0" prefHeight="30.0" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" />
         </rowConstraints>
         <children>
            <Label text="Código" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtCodigo" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label text="Nombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Categoría" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Label text="Precio" GridPane.rowIndex="2" />
            <Label text="Stock" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Estado" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="txtPrecio" GridPane.rowIndex="3" />
            <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbEstado" prefHeight="25.0" prefWidth="218.0" GridPane.columnIndex="2" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox spacing="10">
         <children>
            <Button onAction="#btnNuevo" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Nuevo" />
            <Button onAction="#btnGuardar" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Guardar" />
            <Button mnemonicParsing="false" onAction="#btnActualizar" style="-fx-background-color: FFB421; -fx-text-fill: white;" text="Actualizar" />
            <Button mnemonicParsing="false" onAction="#btnEliminar" style="-fx-background-color: FF2121; -fx-text-fill: white;" text="Eliminar" />
            <Button mnemonicParsing="false" onAction="#btnLimpiar" style="-fx-text-fill: white; -fx-background-color: B39494;" text="Limpiar" />
            <Label fx:id="lblMensaje" text="Label" textFill="#ff8787">
               <font>
                  <Font name="Times New Roman Bold Italic" size="15.0" />
               </font>
            </Label>
         </children>
      </HBox>
      <HBox prefHeight="24.0" prefWidth="672.0" spacing="100.0">
         <children>
            <Label text="Lista de Productos">
               <font>
                  <Font name="Trebuchet MS Italic" size="15.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#btnBuscar" text="Buscar">
               <graphic>
                  <TextField fx:id="txtBuscar" promptText="Buscar Producto" />
               </graphic>
            </Button>
         </children>
      </HBox>
      <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="70.0" text="Código" />
            <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
            <TableColumn fx:id="colCategoria" text="Categoría" />
            <TableColumn fx:id="colPrecio" text="Precio" />
            <TableColumn fx:id="colStock" text="Stock" />
            <TableColumn fx:id="colEstado" text="Estado" />
            <TableColumn prefWidth="100.0" text="Acciones" />
         </columns>
      </TableView>
   </children>
</VBox>
